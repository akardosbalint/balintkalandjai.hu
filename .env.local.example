# MailerLite API kulcs — MailerLite fiók → Integrations → Developer API
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# A csoport (group) ID-ja, amibe a feliratkozók kerüljenek
# MailerLite fiók → Subscribers → Groups → válaszd ki / hozd létre a csoportot,
# majd a csoport URL-jéből vagy az API-ból olvasd ki az ID-t
MAILERLITE_GROUP_ID=your_mailerlite_group_id_here
