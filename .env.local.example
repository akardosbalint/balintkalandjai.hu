# Kit (korábban ConvertKit) API kulcs — Kit fiók → Settings → Developer → API Keys (V4 API Key)
KIT_API_KEY=your_kit_api_key_here

# Annak a Kit form-nak az ID-ja, amihez a feliratkozók kerüljenek.
# A form felelős a double opt-in megerősítő email kiküldéséért is —
# győződj meg róla, hogy a form "Incentive email" / opt-in beállítása
# double opt-in-re van állítva. Kit fiók → Grow → Landing Pages & Forms →
# válaszd ki / hozd létre a formot, az ID a form URL-jéből olvasható ki.
KIT_FORM_ID=your_kit_form_id_here
