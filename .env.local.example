# Kit (korábban ConvertKit) V4 API kulcs — Kit fiók → Account Settings →
# Developer → V4 API Key
KIT_API_KEY=your_kit_v4_api_key_here

# A form ID-ja, amihez a feliratkozók kerüljenek (ez indítja a double
# opt-in / üdvözlő szekvenciát) — Kit fiók → Grow → Landing Pages & Forms →
# nyisd meg a formot, az ID a szerkesztő URL-jéből olvasható ki
# (app.kit.com/forms/designers/<ID>/edit)
KIT_FORM_ID=your_kit_form_id_here
